          "id": "call_pr_problem2",
          "name": "problem",
          "arguments": {
            "statement": "One mole of ideal gas is compressed adiabatically. Explain why its temperature rises.",
            "mode": "recall",
            "target": [
              "n_c95d76921e15"
            ],
            "modelSolution": "Q = 0, so ΔU = −W; the work done on the gas raises U and therefore T."
          }
        }
      ],
      "timestamp": 1790093850000
