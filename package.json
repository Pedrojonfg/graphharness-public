{
  "name": "graphharness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:eval": "cd apps/eval && uv run --extra dev pytest -q",
    "build:pwa": "pnpm --filter @graphharness/pwa build",
    "generate:openapi": "pnpm --filter @graphharness/contracts generate:openapi"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
