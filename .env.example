# graphharness — configuration. Nothing is hard-coded in the code (D22).

# Services
LH_BASE_URL=http://127.0.0.1:3000
# LH URL on the tailnet, for the session links returned to the agent
LH_PUBLIC_URL=https://vps.tailnet.ts.net
EVAL_URL=http://127.0.0.1:8001
HUB_PORT=4100
HUB_DB=/var/lib/hub/hub.sqlite
HUB_REPORTS_DIR=/var/lib/hub/reports
HUB_FIGURES_DIR=/var/lib/hub/figures
HUB_MCP_TOKEN=
MATERIALS_DIR=/home/lh/materials

# Hub LLM (D24)
LLM_PROVIDER=claude-cli
LLM_TIER_CHEAP=haiku
LLM_TIER_STRONG=sonnet
# openai-compatible only:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=

# Sessions and declarations
SESSION_IDLE_CLOSE_MIN=45
DECLARATION_CONFIRM_DEFER_MIN=10
DECLARATION_EXPIRE_DAYS=14

# Backups
BACKUP_REPO=git@github.com:<you>/<backup-repo>.git
BACKUP_SCRIPT=/opt/graphharness/infra/scripts/backup.sh

# LaTeX reports (GL-058)
TIKZ_FRAGMENT_MAX_CHARS=8000
TIKZ_COMPILE_TIMEOUT_SEC=25
TIKZ_COMPILE_MAX_RETRIES=2

# N-day plan between sessions (ADR 105 §7)
PLAN_ITEMS_PER_DAY=5

# Mastery domain — GL default values
SOLID_PROBABILITY_THRESHOLD=0.75
REVIEW_PROBABILITY_THRESHOLD=0.40
PRIOR_PROBABILITY=0.50
GRADE_CORRECT_DELTA=0.15
GRADE_INCORRECT_DELTA=-0.20
EVIDENCE_HALFLIFE_REASONED_DAYS=60
EVIDENCE_HALFLIFE_QUICK_DAYS=30
EVIDENCE_HALFLIFE_STRAIN_DAYS=21
EVIDENCE_HALFLIFE_MANUAL_PENDING_DAYS=5
EVIDENCE_HALFLIFE_MANUAL_CONFIRMED_DAYS=45
DIAGNOSTIC_STALE_PROBABILITY=0.55
FLASHCARD_EVIDENCE_WEIGHT=0.5
INFERENCE_BUMP_SCALE=0.45

# Evidence weights (ADR 106): weight = base × clamp(missClass × confidence × time, MIN, MAX)
WEIGHT_MISS_CARELESS=0.4
WEIGHT_MISS_EXECUTION=0.8
WEIGHT_MISS_CUE=1
WEIGHT_MISS_DISCRIMINATION=1
WEIGHT_MISS_STRUCTURAL=1.2
WEIGHT_CONF_BASE=0.75
WEIGHT_CONF_SPAN=0.5
WEIGHT_TIME_FAST_MS=5000
WEIGHT_TIME_FAST=1.1
WEIGHT_TIME_SLOW_MS=30000
WEIGHT_TIME_SLOW=0.9
WEIGHT_MIN=0.25
WEIGHT_MAX=1.5
